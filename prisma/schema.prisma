// Prisma schema — Coworking ERP (PATCH v2: cabins, employee directory, vendor invoice OCR, blacklist, half-price seats)
generator client {
  provider      = "prisma-client-js"
  // "native" = the machine that runs `prisma generate` (local dev).
  // "debian-openssl-3.0.x" = the production server runtime — without it, deploys
  // fail with "could not locate the Query Engine" because the engine binary for
  // that platform is never generated. See pris.ly/engine-not-found-tooling-investigation.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============= USERS & AUTH =============
model User {
  id            String   @id @default(cuid())
  emp_id        String?  @unique
  email         String   @unique
  name          String
  passwordHash  String
  role          String   // ADMIN | OWNER | MANAGER | SALES | OPS | CENTER_MANAGER | ACCOUNTS | IT | CLIENT
  centerId      String?
  center        Center?  @relation(fields: [centerId], references: [id])

  // CLIENT users — link to employer Client (for employee directory)
  employerClientId String?
  employerClient   Client?  @relation("ClientEmployees", fields: [employerClientId], references: [id])
  aadhaar          String?
  pan              String?
  designation      String?

  phone         String?
  active        Boolean  @default(true)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Patch v4 — per-user module override + user transfer audit
  allowedModules  String?   // JSON array of module names; null = role defaults
  transferredToId String?
  transferredTo   User?     @relation("UserTransferTo", fields: [transferredToId], references: [id])
  transferredFrom User[]    @relation("UserTransferTo")
  transferredAt   DateTime?

  leadsOwned        Lead[]        @relation("LeadOwner")
  proposalsCreated  Proposal[]    @relation("ProposalCreator")
  proposalsApproved Proposal[]    @relation("ProposalApprover")
  prsRaised         PurchaseRequest[]
  posIssued         PurchaseOrder[]
  comments          Comment[]
  reviewsCreated    Review[]      @relation("ReviewCreator")
  commentEdits      CommentEdit[]
  attendance        AttendanceLog[]
  tickets           Ticket[]
  bookings          Booking[]
  picOf             Client[]       @relation("ClientPIC")
  staffAttendance   StaffAttendance[]
  leavesRequested   LeaveRequest[]    @relation("LeaveRequester")
  leavesDecided     LeaveRequest[]    @relation("LeaveDecider")
  auditLogs         AuditLog[]

  // Occupancy module
  allocationsMade   Allocation[]
  reservationsMade  Reservation[]

  passwordResets    ClientInvite[] @relation("UserResets")

  // Patch v4 — invites, password-reset requests, user transfers
  invitesIssued      UserInvite[]            @relation("InvitedBy")
  pwdResetRequests   PasswordResetRequest[]
  transfersFrom      UserTransfer[]          @relation("TransferFrom")
  transfersTo        UserTransfer[]          @relation("TransferTo")
  transfersDecided   UserTransfer[]          @relation("TransferredBy")

  // Housekeeping / inspection module
  hkRounds           InspectionRound[]       @relation("HkRoundUser")
  hkVisits           InspectionVisit[]       @relation("HkVisitUser")
  hkPhotos           InspectionPhoto[]       @relation("HkPhotoUser")
  hkDevices          DeviceRegistration[]    @relation("HkDeviceUser")

  // Housekeeping — issues & corrective actions (Phase 6)
  hkIssuesRaised     HkIssue[]               @relation("HkIssueRaiser")
  hkIssuesAssigned   HkIssue[]               @relation("HkIssueAssignee")
  hkIssuesClosed     HkIssue[]               @relation("HkIssueCloser")
  hkActions          CorrectiveAction[]      @relation("HkActionAssignee")
  hkReinspections    ReinspectionRecord[]    @relation("HkReinspectionVerifier")

  // Housekeeping — generator monitoring (Phase 7)
  genEvents          GeneratorEvent[]        @relation("GenEventUser")
  genReadings        GeneratorReading[]      @relation("GenReadingUser")
  genRefills         GeneratorRefill[]       @relation("GenRefillUser")
  genDiscrepancies   GeneratorDiscrepancy[]  @relation("GenDiscrepancyResolver")

  // Housekeeping — alerts & scoring (Phase 8)
  hkAlertsAcked      HkAlert[]               @relation("HkAlertAck")
  hkScores           HkEfficiencyScore[]     @relation("HkEfficiencyUser")
  hkScoreOverrides   HkEfficiencyScore[]     @relation("HkEfficiencyOverride")

  // Housekeeping — client cleaning requests (Phase 9)
  crAssigned         CleaningRequest[]       @relation("CrAssignee")
  crEvents           CleaningRequestEvent[]  @relation("CrEventActor")
}

// ============= CENTERS =============
model Center {
  id                String   @id @default(cuid())
  name              String
  city              String
  address           String?
  totalSeats        Int      @default(0)
  mapImagePath      String?  @db.Text // digital floor map
  commonAreaPhotos  String?  @db.Text // JSON array of file paths
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  users         User[]
  leads         Lead[]
  visitors      Visitor[]
  proposals     Proposal[]
  clients       Client[]
  prs           PurchaseRequest[]
  pos           PurchaseOrder[]
  inventory     InventoryItem[]
  assets        Asset[]
  repairs       Repair[]
  bookings      Booking[]
  meetingRooms  MeetingRoom[]
  notices       Notice[]
  attendance    AttendanceLog[]
  expenses      Expense[]
  invoices      ClientInvoice[]
  cabins        Cabin[]
  seats         Seat[]
  staffAttendance StaffAttendance[]

  // Occupancy module
  floors        Floor[]
  zones         Zone[]
  spaces        Space[]

  // Housekeeping / inspection module
  inspectionLocations InspectionLocation[]
  inspectionRounds    InspectionRound[]
  hkIssues            HkIssue[]
  generators          Generator[]
  hkAlerts            HkAlert[]
  emailGroups         EmailGroup[]
  cleaningRequests    CleaningRequest[]
}

// ============= CABINS (NEW) =============
// A center is divided into cabins (e.g., 6-seater) + open seats. The seat map renders these.
model Cabin {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  floorId     String?
  floor       Floor?   @relation(fields: [floorId], references: [id])
  name        String   // e.g., "Cabin A1"
  capacity    Int      // seats inside the cabin
  photos      String?  @db.Text // JSON array of file paths
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  seats       Seat[]
  proposals   Proposal[]
  clients     Client[]
  spaces      Space[]   // occupancy module bridge
}

// ============= CRM: LEADS =============
model Lead {
  id            String    @id @default(cuid())
  source        String
  name          String
  email         String?
  phone         String?
  company       String?
  seatsNeeded   Int?
  budget        Float?
  notes         String?  @db.Text
  status        String    @default("Lead")
  ownerId       String?
  owner         User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  centerId      String?
  center        Center?   @relation(fields: [centerId], references: [id])

  // Channel partner this lead came through (Broker / Agent / IPC).
  sourceType        String?         // "Broker" | "Agent" | "IPC"
  partnerContactId  String?
  partnerContact    PartnerContact? @relation(fields: [partnerContactId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      Comment[]
  visitors      Visitor[]
  proposals     Proposal[]
}

// A channel partner FIRM: a Broker / Agent / IPC organisation. Holds many contact people.
model Partner {
  id            String           @id @default(cuid())
  type          String           // "Broker" | "Agent" | "IPC"
  organisation  String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  contacts      PartnerContact[]

  @@unique([type, organisation])
}

// A contact person belonging to a Partner firm.
model PartnerContact {
  id            String   @id @default(cuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads         Lead[]
  clients       Client[] @relation("ClientPartnerContact")
}

model Comment {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  channel   String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  // Edit tracking: who/when the current body was last changed; full prior versions in CommentEdit.
  editedAt   DateTime?
  editedById String?
  edits      CommentEdit[]
}

// Immutable audit log: one row per edit of a Comment, storing the body it had BEFORE that edit.
model CommentEdit {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  prevBody  String   @db.Text
  editorId  String?
  editor    User?    @relation(fields: [editorId], references: [id])
  createdAt DateTime @default(now())
}

// ============= VISITORS / KYC =============
model Visitor {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  aadhaar       String?
  pan           String?
  kycVerified   Boolean  @default(false)
  digilockerRef String?
  tourTaken     Boolean  @default(false)
  tourDate      DateTime?
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])
  centerId      String?
  center        Center?  @relation(fields: [centerId], references: [id])
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
}

// ============= PROPOSALS =============
model Proposal {
  id              String   @id @default(cuid())
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  centerId        String
  center          Center   @relation(fields: [centerId], references: [id])
  cabinId         String?
  cabin           Cabin?   @relation(fields: [cabinId], references: [id])
  quotedPrice     Float
  negotiatedPrice Float
  securityDeposit Float
  lockInMonths    Int
  customisations  String?  @db.Text
  imagesJson      String?  @db.Text // auto-populated from cabin + center common area on send
  pdfSnapshot     String?  // public path of the last edited+saved proposal document (HTML)
  status          String   @default("DRAFT")
  belowThreshold  Boolean  @default(false)
  approverNotes   String?
  createdById     String
  createdBy       User     @relation("ProposalCreator", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?    @relation("ProposalApprover", fields: [approvedById], references: [id])
  sentAt          DateTime?
  acceptedAt      DateTime?
  acceptanceFile  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client?
}

// ============= CLIENTS / ONBOARDING / CONTRACTS =============
model Client {
  id                String    @id @default(cuid())
  companyName       String
  contactName       String
  email             String
  phone             String?
  centerId          String
  center            Center    @relation(fields: [centerId], references: [id])
  cabinId           String?
  cabin             Cabin?    @relation(fields: [cabinId], references: [id])
  proposalId        String?   @unique
  proposal          Proposal? @relation(fields: [proposalId], references: [id])
  startDate         DateTime?
  specialAgreement  String?
  sentToOps         Boolean   @default(false)
  cmConfirmed       Boolean   @default(false)
  clientConfirmed   Boolean   @default(false)
  active            Boolean   @default(true)
  occupiedSeats     Int       @default(0)   // how many seats client is actually using
  totalCabinSeats   Int       @default(0)   // capacity of cabin/center taken
  unusedSeatReminderSent Boolean @default(false)
  unusedSeatLastReminderAt DateTime?
  picUserId         String?                  // Person In Charge (User.id)
  pic               User?     @relation("ClientPIC", fields: [picUserId], references: [id])

  // Channel partner this client came through (Broker / Agent / IPC) — mirrors Lead.
  sourceType        String?         // "Broker" | "Agent" | "IPC"
  partnerContactId  String?
  partnerContact    PartnerContact? @relation("ClientPartnerContact", fields: [partnerContactId], references: [id])

  createdAt         DateTime  @default(now())

  contract          Contract?
  invoices          ClientInvoice[]
  tickets           Ticket[]
  feedback          Feedback[]
  bookings          Booking[]
  referralsMade     Referral[] @relation("ReferralMadeBy")
  referralsReceived Referral[] @relation("ReferralFor")
  employees         User[]     @relation("ClientEmployees")
  invites           ClientInvite[] @relation("ClientInvites")

  // Occupancy module
  allocations       Allocation[]

  // Housekeeping — client cleaning requests (Phase 9)
  cleaningRequests CleaningRequest[]

}

model Contract {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  monthlyRent     Float
  securityDeposit Float
  incrementPct    Float
  revisionDate    DateTime
  reminderSent    Boolean  @default(false)
  filePath        String?  // uploaded existing contract
  ocrParsedJson   String?  @db.Text // OCR result (renew date, terms etc.)
  createdAt       DateTime @default(now())

  allocations     Allocation[]   // occupancy module
}

// ============= VENDORS / PROCUREMENT =============
model Vendor {
  id            String   @id @default(cuid())
  name          String
  category      String
  contact       String?
  email         String?
  phone         String?
  gstin         String?
  panNumber     String?
  bankDetails   String?
  active        Boolean  @default(true)
  blacklisted   Boolean  @default(false)
  blacklistRemarks String?
  deletedAt     DateTime?
  rateCardJson  String?  @db.Text
  createdAt     DateTime @default(now())

  pos          PurchaseOrder[]
  invoices     VendorInvoice[]
}

model PurchaseRequest {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  raisedById  String
  raisedBy    User     @relation(fields: [raisedById], references: [id])
  itemsJson   String
  reason      String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  pos         PurchaseOrder[]
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique @default(cuid())
  prId            String?
  pr              PurchaseRequest? @relation(fields: [prId], references: [id])
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  centerId        String
  center          Center   @relation(fields: [centerId], references: [id])
  issuedById      String
  issuedBy        User     @relation(fields: [issuedById], references: [id])
  itemsJson       String
  totalAmount     Float
  isRecurring     Boolean  @default(false)
  recurrence      String?
  category        String
  piFile          String?
  invoiceFile     String?
  paymentStatus   String   @default("UNPAID")
  deliveryConfirmed Boolean @default(false)
  deliveryNotes   String?
  deliveryPhotos  String?
  createdAt       DateTime @default(now())

  vendorInvoices  VendorInvoice[]
}

// ============= VENDOR INVOICES (NEW — upload, OCR, PO match, approve) =============
model VendorInvoice {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  poId         String?
  po           PurchaseOrder? @relation(fields: [poId], references: [id])
  filePath     String   // uploaded invoice
  ocrJson      String?  @db.Text  // OCR-parsed fields (invoice no, amount, gst, date, po ref)
  invoiceNo    String?
  invoiceDate  DateTime?
  amount       Float    @default(0)
  gst          Float    @default(0)
  poMatchStatus String  @default("UNMATCHED") // UNMATCHED | MATCHED | MISMATCH
  status       String   @default("PENDING")    // PENDING | APPROVED | REJECTED | BOOKED
  approvedById String?
  remarks      String?  @db.Text
  createdAt    DateTime @default(now())
}

// ============= INVENTORY & ASSETS =============
model InventoryItem {
  id            String   @id @default(cuid())
  centerId      String
  center        Center   @relation(fields: [centerId], references: [id])
  name          String
  category      String
  unit          String
  currentStock Float    @default(0)
  threshold     Float    @default(0)
  consumptionLog String?
  updatedAt     DateTime @updatedAt
}

model Asset {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  name        String
  category    String
  serialNo    String?
  location    String?
  purchaseDate DateTime?
  cost        Float?
  status      String   @default("OK")
  createdAt   DateTime @default(now())
}

// ============= REPAIRS =============
model RepairCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Repair {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  category    String
  description String
  reportedBy  String?
  assignedTo  String
  vendorId    String?
  cost        Float?
  status      String   @default("OPEN")
  photos      String?  @db.Text
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// ============= MEETING ROOMS / BOOKINGS =============
model MeetingRoom {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  name      String
  capacity  Int
  hourlyRate Float   @default(0)
  amenities String?  @db.Text // JSON array of amenity strings e.g. ["Projector","Whiteboard","AC"]
  active    Boolean  @default(true)

  bookings  Booking[]
  spaces    Space[]   // occupancy module bridge
}

model Booking {
  id        String   @id @default(cuid())
  roomId    String
  room      MeetingRoom @relation(fields: [roomId], references: [id])
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  bookedById String
  bookedBy  User     @relation(fields: [bookedById], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  startTime DateTime
  endTime   DateTime
  durationHrs Float    @default(0)
  isChargeable Boolean @default(false)   // true if this booking is past quota
  chargedAmount Float  @default(0)
  notes         String?  @db.Text
  lateEntryReason String? @db.Text   // required when ADMIN/CM back-dates a booking (start in the past)
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
}

// ============= CLIENT INVOICES =============
model ClientInvoice {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  centerId     String
  center       Center   @relation(fields: [centerId], references: [id])
  invoiceNo    String   @unique
  periodStart  DateTime
  periodEnd    DateTime
  baseAmount   Float
  halfPriceLine Float   @default(0)   // unused-seat half-price portion
  meetingRoomLine Float @default(0)   // overage charges
  gstAmount    Float    @default(0)
  totalAmount  Float
  status       String   @default("ISSUED")
  issuedAt     DateTime @default(now())
  paidAt       DateTime?
  emailSent    Boolean  @default(false)
}

// ============= CLIENT PORTAL =============
model Ticket {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  raisedById String?
  raisedBy  User?    @relation(fields: [raisedById], references: [id])
  category  String
  subject   String
  body      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  rating    Int
  body      String?  @db.Text
  createdAt DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id])
  title     String
  body      String
  isAd      Boolean  @default(false)
  brand     String?
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
}

// ============= REFERRALS =============
model Referral {
  id            String   @id @default(cuid())
  referrerType  String
  referrerId    String?
  referrer      Client?  @relation("ReferralMadeBy", fields: [referrerId], references: [id])
  referrerName  String
  contact       String?
  prospectName  String
  prospectPhone String?
  converted     Boolean  @default(false)
  convertedClientId String?
  convertedClient Client? @relation("ReferralFor", fields: [convertedClientId], references: [id])
  feeAmount     Float    @default(0)
  feePaid       Boolean  @default(false)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
}

// ============= ACCOUNTS / EXPENSES / LEDGER =============
model Expense {
  id        String   @id @default(cuid())
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id])
  category  String
  amount    Float
  gst       Float    @default(0)
  tds       Float    @default(0)
  payee     String
  paymentMode String
  date      DateTime @default(now())
  notes         String?  @db.Text
  attachment String?
}

model LedgerEntry {
  id        String   @id @default(cuid())
  account   String
  debit     Float    @default(0)
  credit    Float    @default(0)
  refType   String
  refId     String?
  centerId  String?
  date      DateTime @default(now())
  narration String?
}

// ============= ATTENDANCE & SOPs =============
model AttendanceLog {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  reportedById String
  reportedBy  User     @relation(fields: [reportedById], references: [id])
  date        DateTime @default(now())
  cleanliness String
  issuesNote  String?  @db.Text
  photos      String?  @db.Text
}

model Sop {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String
  fileUrl   String?
  createdAt DateTime @default(now())
}

// ============= LEAVE MANAGEMENT =============
model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("LeaveRequester", fields: [userId], references: [id])
  startDate   DateTime  // midnight (server local) of first leave day
  endDate     DateTime  // midnight (server local) of last leave day (inclusive)
  type        String    // CASUAL | SICK | PAID | UNPAID | OTHER
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById String?
  decidedBy   User?     @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  notes         String?  @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============= STAFF ATTENDANCE (personal check-in / check-out) =============
model StaffAttendance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime  // midnight (server local) of the day
  checkInAt   DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkInAccM Float?    // GPS accuracy, metres
  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?
  checkOutAccM Float?   // GPS accuracy, metres
  centerId    String?
  center      Center?   @relation(fields: [centerId], references: [id])
  status      String    @default("PRESENT") // PRESENT | LATE | HALF_DAY | LEAVE | HOLIDAY | ABSENT
  notes         String?  @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
}

// ============= AUDIT LOG =============
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. CLIENT_CREATED, INVOICE_SENT, PROPOSAL_APPROVED
  targetType String?  // e.g. Client, Proposal, Invoice
  targetId   String?
  meta       String?  @db.Text // JSON string for extra context
  createdAt  DateTime @default(now())
}

// ============= CLIENT INVITES / PASSWORD RESET =============
// Single token store for two flows (distinguished by `type`):
//   INVITE — admin/CM invites a client contact; recipient sets name + password to create a CLIENT user.
//   RESET  — a client requests a password reset; recipient sets a new password.
model ClientInvite {
  id               String    @id @default(cuid())
  token            String    @unique
  type             String    @default("INVITE") // INVITE | RESET
  email            String
  // INVITE: the employer Client the new user will belong to.
  employerClientId String?
  employerClient   Client?   @relation("ClientInvites", fields: [employerClientId], references: [id])
  // RESET: the existing user whose password is being reset.
  userId           String?
  user             User?     @relation("UserResets", fields: [userId], references: [id])
  invitedById      String?   // staff user who generated an INVITE
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([employerClientId])
  @@index([expiresAt, usedAt])
}

// ============= SEAT MAP =============
model Seat {
  id            String   @id @default(cuid())
  centerId      String
  center        Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  cabinId       String?
  cabin         Cabin?   @relation(fields: [cabinId], references: [id])
  number        String
  zone          String?
  assignedClientId String?
  occupied      Boolean  @default(false)
  partialOccupancy Boolean @default(false)  // true = orange (client took cabin but not this seat)
  createdAt     DateTime @default(now())

  spaces        Space[]  // occupancy module bridge

  @@unique([centerId, number])
}

// ============= OCCUPANCY MODULE =============
// Additive layer over Center/Cabin/Seat/MeetingRoom. Space is the unified occupancy unit;
// it bridges back to the existing Seat/Cabin/MeetingRoom rows via optional FKs so the current
// seatmap/bookings keep working. Status here is kept in sync with Seat.occupied (see lib/occupancy).

enum SpaceType {
  DEDICATED_SEAT
  HOT_DESK
  CABIN
  MEETING_ROOM
  PRIVATE_OFFICE
  VIRTUAL_OFFICE
}

enum SpaceStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
}

enum AllocationStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  TRANSFERRED
}

model Floor {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name      String          // "Ground", "1st Floor"
  level     Int             // 0,1,2 … for ordering
  planImages String? @db.Text // JSON array of floor-plan image paths (at least one required)
  createdAt DateTime @default(now())

  zones     Zone[]
  spaces    Space[]
  cabins    Cabin[]
  inspectionLocations InspectionLocation[]

  @@unique([centerId, level])
  @@index([centerId])
}

model Zone {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  floorId   String?
  floor     Floor?   @relation(fields: [floorId], references: [id])
  name      String          // "North Wing", "Quiet Zone"
  createdAt DateTime @default(now())

  spaces    Space[]

  @@index([centerId])
  @@index([floorId])
}

model Space {
  id        String      @id @default(cuid())
  code      String                       // human code e.g. "F2-Z1-S05"
  name      String
  type      SpaceType
  capacity  Int         @default(1)
  status    SpaceStatus @default(AVAILABLE)

  centerId  String
  center    Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  floorId   String?
  floor     Floor?      @relation(fields: [floorId], references: [id])
  zoneId    String?
  zone      Zone?       @relation(fields: [zoneId], references: [id])

  // Optional bridges to existing models (one set per Space, depending on type)
  cabinId       String?
  cabin         Cabin?       @relation(fields: [cabinId], references: [id])
  seatId        String?
  seat          Seat?        @relation(fields: [seatId], references: [id])
  meetingRoomId String?
  meetingRoom   MeetingRoom? @relation(fields: [meetingRoomId], references: [id])

  // visual map coordinates (occupancy map view)
  gridX     Int?
  gridY     Int?

  deletedAt DateTime?                     // soft delete only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations  Allocation[]
  reservations Reservation[]
  transfers    SpaceTransfer[]

  @@unique([centerId, code])
  @@index([centerId, status])
  @@index([floorId])
  @@index([zoneId])
  @@index([type, status])
}

model Allocation {
  id            String  @id @default(cuid())
  spaceId       String
  space         Space   @relation(fields: [spaceId], references: [id])
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id])
  contractId    String?                       // reuse Contract as the agreement
  contract      Contract? @relation(fields: [contractId], references: [id])

  seatsTaken    Int      @default(1)          // partial cabin/floor allocation
  startDate     DateTime
  endDate       DateTime?
  status        AllocationStatus @default(ACTIVE)

  allocatedById String
  allocatedBy   User     @relation(fields: [allocatedById], references: [id])

  deletedAt     DateTime?                      // soft delete only
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       OccupancyHistory[]

  @@index([clientId])
  @@index([spaceId, status])
  @@index([status, endDate])                   // expiring-soon queries
}

// Append-only ledger. NEVER updated or deleted — one row per occupancy event.
model OccupancyHistory {
  id            String      @id @default(cuid())
  allocationId  String?
  allocation    Allocation? @relation(fields: [allocationId], references: [id])
  spaceId       String
  clientId      String?
  prevClientId  String?                        // for transfers
  event         String                         // ALLOCATED|RELEASED|TRANSFERRED|EXPIRED|RESERVED|RESERVATION_EXPIRED
  startDate     DateTime?
  endDate       DateTime?
  vacatedAt     DateTime?
  actorId       String?
  meta          String?     @db.Text           // JSON snapshot
  createdAt     DateTime    @default(now())

  @@index([spaceId])
  @@index([clientId])
  @@index([allocationId])
}

model Reservation {
  id           String   @id @default(cuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id])
  reservedById String
  reservedBy   User     @relation(fields: [reservedById], references: [id])
  clientId     String?                          // optional held-for client
  reservedAt   DateTime @default(now())
  expiresAt    DateTime
  released     Boolean  @default(false)         // cron sets true on expiry/consumption
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([expiresAt, released])                // cron sweep
  @@index([spaceId])
}

model SpaceTransfer {
  id               String   @id @default(cuid())
  spaceId          String
  space            Space    @relation(fields: [spaceId], references: [id])
  fromClientId     String?
  toClientId       String?
  fromAllocationId String?
  toAllocationId   String?
  batchId          String?                       // groups a bulk transfer
  transferredById  String
  reason           String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([batchId])
  @@index([spaceId])
}

// ============= REVIEWS / FEEDBACK =============
// Feedback submitted by clients and visitors. Visitor-specific fields
// (purposeOfVisit, visitorNote) are populated only when isVisitor is true.
model Review {
  id             String   @id @default(cuid())
  name           String
  phoneNumber    String
  companyName    String
  email          String?
  feedback       String   @db.Text
  isVisitor      Boolean  @default(false)
  purposeOfVisit String?                    // required when isVisitor
  status         String   @default("Active") // Active | Deleted
  createdById    String?                     // staff user who captured it, if any
  createdBy      User?    @relation("ReviewCreator", fields: [createdById], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([isVisitor])
}

// ============= PATCH v4: INVITES, PASSWORD RESETS, USER TRANSFERS =============

// Admin-issued invite to onboard a new user with an optional per-user module override.
model UserInvite {
  id             String    @id @default(cuid())
  token          String    @unique
  email          String    @unique
  name           String
  role           String
  centerId       String?
  allowedModules String?   // JSON array of module names; null = default for role
  invitedById    String
  invitedBy      User      @relation("InvitedBy", fields: [invitedById], references: [id])
  status         String    @default("PENDING")  // PENDING | ACCEPTED | EXPIRED | CANCELLED
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdUserId  String?
  createdAt      DateTime  @default(now())

  @@index([status])
}

// Password reset requiring admin approval; one-time token is minted on approval.
model PasswordResetRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  reason       String?
  token        String?   @unique
  expiresAt    DateTime?
  status       String    @default("PENDING")  // PENDING | APPROVED | REJECTED | USED | EXPIRED
  decidedById  String?
  decidedAt    DateTime?
  remarks      String?
  createdAt    DateTime  @default(now())

  @@index([status])
}

// Audit record of reassigning one user's open work to another (on leave / left org).
model UserTransfer {
  id                  String   @id @default(cuid())
  fromUserId          String
  fromUser            User     @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUserId            String
  toUser              User     @relation("TransferTo", fields: [toUserId], references: [id])
  reason              String?
  recordsAffectedJson String?  @db.Text
  transferredById     String
  transferredBy       User     @relation("TransferredBy", fields: [transferredById], references: [id])
  createdAt           DateTime @default(now())

  @@index([fromUserId])
}

// ============================================================================
// HOUSEKEEPING / INSPECTION MODULE
// Design + phase checklist: docs/housekeeping-module.md
// Phase 1 scope — the models needed by the inspection flow (locations, QR,
// rounds, visits, photos, GPS, devices). Issues / generator / alerts / cleaning
// requests land in later phases and are deliberately not declared yet.
// ============================================================================

enum HkLocationCategory {
  BATHROOM
  COMMON_AREA
  PARKING
  FRONT_AREA
  BACK_AREA
  GUARD_ROOM
  ELECTRICITY_ROOM
  GENERATOR_AREA
  FUEL_TANK
  PANTRY
  MEETING_ROOM
  RECEPTION
  OTHER
}

enum HkRoundStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum HkVisitStatus {
  SCANNED      // QR accepted, photos not yet submitted
  SUBMITTED    // photos captured + submitted
  REJECTED     // rejected by a reviewer
}

enum HkPhotoSource {
  CAMERA       // captured live in-app (the norm)
  GALLERY      // manager exception — always flagged
}

// An inspectable area. NOT a `Space`: Space is rentable inventory tied to
// allocations/invoices; a bathroom or guard room is not rentable and must never
// affect occupancy maths.
model InspectionLocation {
  id                 String             @id @default(cuid())
  centerId           String
  center             Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  floorId            String?
  floor              Floor?             @relation(fields: [floorId], references: [id])

  name               String
  category           HkLocationCategory @default(OTHER)
  sortOrder          Int                @default(0)

  // Geofence — null lat/lng means "not yet captured"; verification then flags
  // rather than rejects, so a half-configured centre still works.
  lat                Float?
  lng                Float?
  geofenceRadiusM    Int                @default(50)

  requiredPhotoCount Int                @default(4)
  requiredAngles     String?            @db.Text  // JSON array of angle labels
  checklist          String?            @db.Text  // JSON array of checklist items
  minDwellSeconds    Int                @default(60)
  frequencyPerDay    Int                @default(1)
  priority           String             @default("NORMAL") // LOW|NORMAL|HIGH|CRITICAL

  active             Boolean            @default(true)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  qrCodes            LocationQrCode[]
  clientQrCodes      ClientQrCode[]
  visits             InspectionVisit[]
  photos             InspectionPhoto[]
  issues             HkIssue[]
  cleaningRequests   CleaningRequest[]

  @@index([centerId, active])
  @@index([floorId])
  @@index([centerId, sortOrder])
}

// The printed QR. `code` is opaque and random — it carries no centre/area
// information; everything is resolved server-side. Rotation inserts a new row
// and deactivates the old one, so an old printout can be identified, never
// silently accepted.
model LocationQrCode {
  id         String             @id @default(cuid())
  locationId String
  location   InspectionLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code       String             @unique
  version    Int                @default(1)
  active     Boolean            @default(true)
  rotatedAt  DateTime?
  createdAt  DateTime           @default(now())

  visits     InspectionVisit[]

  @@index([locationId, active])
}

model InspectionRound {
  id          String            @id @default(cuid())
  centerId    String
  center      Center            @relation(fields: [centerId], references: [id])
  userId      String
  user        User              @relation("HkRoundUser", fields: [userId], references: [id])

  status      HkRoundStatus     @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  distanceM   Float?
  score       Float?
  flags       String?           @db.Text // JSON array of verification flags
  notes       String?           @db.Text

  visits      InspectionVisit[]
  gpsLogs     GpsLog[]

  @@index([centerId, startedAt])
  @@index([userId, status])
}

// One scan + submission at one location. `scannedAt`/`submittedAt` are SERVER
// time; device-reported time is kept separately on photos so the two can be
// compared without a device clock ever moving a server timestamp.
model InspectionVisit {
  id            String             @id @default(cuid())
  roundId       String
  round         InspectionRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  locationId    String
  location      InspectionLocation @relation(fields: [locationId], references: [id])
  qrCodeId      String?
  qrCode        LocationQrCode?    @relation(fields: [qrCodeId], references: [id])
  userId        String
  user          User               @relation("HkVisitUser", fields: [userId], references: [id])

  sequence      Int
  scannedAt     DateTime           @default(now())
  submittedAt   DateTime?
  dwellSeconds  Int?

  deviceId      String?
  lat           Float?
  lng           Float?
  gpsAccuracyM  Float?
  distanceM     Float?             // metres from the location's saved point
  geofenceOk    Boolean            @default(false)

  status        HkVisitStatus      @default(SCANNED)
  flags         String?            @db.Text // JSON array of verification flags
  observations  String?            @db.Text

  photos        InspectionPhoto[]
  issues        HkIssue[]

  @@index([roundId, sequence])
  @@index([locationId, scannedAt])
  @@index([userId, scannedAt])
}

// Photo files live OUTSIDE public/ and are served only via signed, role-checked
// URLs — inspection evidence must not be readable by URL guess.
model InspectionPhoto {
  id            String             @id @default(cuid())
  // Null for corrective-action "after" photographs (Phase 6): those belong to an
  // HkIssue, not to an inspection visit.
  visitId       String?
  visit         InspectionVisit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  locationId    String
  location      InspectionLocation @relation(fields: [locationId], references: [id])
  userId        String
  user          User               @relation("HkPhotoUser", fields: [userId], references: [id])

  angle         String                       // e.g. "Entrance / full area"
  slot          Int                          // 0-based index into requiredAngles
  filePath      String             @db.Text  // server-side path; never sent to the client
  mimeType      String
  sizeBytes     Int

  captureAt     DateTime?                    // device-reported
  serverAt      DateTime           @default(now())
  lat           Float?
  lng           Float?
  deviceId      String?

  sha256        String                       // exact-duplicate detection
  pHash         String?                      // perceptual hash — near-duplicate detection
  qualityScore  Float?
  source        HkPhotoSource      @default(CAMERA)
  beforeAfter   String             @default("BEFORE") // BEFORE|AFTER
  retakeReason  String?
  flags         String?            @db.Text  // JSON array (DUPLICATE, LOW_QUALITY, …)

  aiStatus      String             @default("PENDING") // PENDING|DONE|FAILED|SKIPPED
  createdAt     DateTime           @default(now())

  // Phase 6 — a photo may serve as an issue's "before" or an action's "after" evidence.
  issuesBefore  HkIssue[]          @relation("HkIssueBefore")
  actionsAfter  CorrectiveAction[] @relation("HkActionAfter")

  @@index([visitId, slot])
  @@index([locationId, createdAt])
  @@index([sha256])
  @@index([pHash])
}

// GPS breadcrumbs, recorded ONLY while a round is active (privacy constraint).
model GpsLog {
  id        String          @id @default(cuid())
  roundId   String
  round     InspectionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  at        DateTime        @default(now())
  lat       Float
  lng       Float
  accuracyM Float?

  @@index([roundId, at])
}

model DeviceRegistration {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("HkDeviceUser", fields: [userId], references: [id])
  deviceId    String
  fingerprint String?   @db.Text
  label       String?
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
}

// Key/value config (tolerances, weightages, AI prompts, retention, SLA targets)
// — avoids a schema migration per config knob.
model HkSetting {
  key       String   @id
  value     String   @db.Text // JSON
  updatedAt DateTime @updatedAt
}

// ============================================================================
// HOUSEKEEPING — ISSUES & CORRECTIVE ACTIONS (Phase 6)
// docs/housekeeping-module.md §3 Phase 6
// ============================================================================

enum HkSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum HkIssueStatus {
  OPEN          // raised, not yet assigned
  ASSIGNED      // assigned, work not started
  IN_PROGRESS   // assignee marked started
  AWAITING_VERIFICATION // work submitted with after-photo, pending sign-off
  CLOSED        // verified and closed
  REJECTED      // verification failed → reinspection recorded, returns to ASSIGNED
  CANCELLED     // raised in error
}

enum HkIssueSource {
  INSPECTION    // raised by a supervisor during a round
  AI            // auto-created from an AI finding (Phase 5)
  CLIENT        // from a client cleaning request / complaint (Phase 9)
  MANUAL        // raised directly from the issues console
}

model HkIssue {
  id          String             @id @default(cuid())
  centerId    String
  center      Center             @relation(fields: [centerId], references: [id])
  locationId  String?
  location    InspectionLocation? @relation(fields: [locationId], references: [id])
  visitId     String?
  visit       InspectionVisit?   @relation(fields: [visitId], references: [id])

  source      HkIssueSource      @default(MANUAL)
  category    String             // cleanliness | maintenance | safety | consumables | presentation
  title       String
  description String?            @db.Text
  severity    HkSeverity         @default(MEDIUM)
  status      HkIssueStatus      @default(OPEN)

  // Photo evidence. beforePhoto may come from the inspection that raised it.
  beforePhotoId String?
  beforePhoto   InspectionPhoto? @relation("HkIssueBefore", fields: [beforePhotoId], references: [id])

  raisedById  String
  raisedBy    User               @relation("HkIssueRaiser", fields: [raisedById], references: [id])
  assigneeId  String?
  assignee    User?              @relation("HkIssueAssignee", fields: [assigneeId], references: [id])

  dueAt       DateTime?          // derived from severity SLA at assignment
  escalatedAt DateTime?          // set by the escalation cron; prevents repeat alerts
  closedById  String?
  closedBy    User?              @relation("HkIssueCloser", fields: [closedById], references: [id])
  closedAt    DateTime?

  // Optional bridge to the existing client-facing Ticket flow.
  ticketId    String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  actions       CorrectiveAction[]
  reinspections ReinspectionRecord[]

  @@index([centerId, status])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([locationId])
  @@index([visitId])
}

// One work attempt against an issue. A rejected attempt leaves its row intact and
// a new one is created on retry — the history of attempts is never overwritten.
model CorrectiveAction {
  id           String    @id @default(cuid())
  issueId      String
  issue        HkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     User      @relation("HkActionAssignee", fields: [assigneeId], references: [id])

  startedAt    DateTime?
  completedAt  DateTime?
  afterPhotoId String?
  afterPhoto   InspectionPhoto? @relation("HkActionAfter", fields: [afterPhotoId], references: [id])
  notes        String?   @db.Text
  unableReason String?   @db.Text  // set when the assignee cannot complete it

  createdAt    DateTime  @default(now())

  @@index([issueId])
  @@index([assigneeId])
}

// Immutable verification record — one row per verify/reject decision.
model ReinspectionRecord {
  id           String    @id @default(cuid())
  issueId      String
  issue        HkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actionId     String?
  verifiedById String
  verifiedBy   User      @relation("HkReinspectionVerifier", fields: [verifiedById], references: [id])
  verdict      String    // PASS | FAIL
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([issueId])
}

// ============================================================================
// HOUSEKEEPING — GENERATOR MONITORING (Phase 7)
// docs/housekeeping-module.md §3 Phase 7 · brief §11
// ============================================================================

enum GenEventType {
  ON
  OFF
}

// Why a reading was taken. PERIODIC is the mandatory 30-minute photo while running.
enum GenReadingKind {
  START
  PERIODIC
  STOP
  REFILL
  SPOT_CHECK
}

model Generator {
  id              String   @id @default(cuid())
  centerId        String
  center          Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name            String
  code            String                     // asset/plate code, unique per centre
  tankCapacityL   Float?
  // Expected diesel burn range, used by the "unusual consumption" rule.
  normalLphMin    Float?
  normalLphMax    Float?
  photoIntervalMin Int     @default(30)      // mandatory photo cadence while ON
  graceMin        Int      @default(10)      // slack before a missed photo is raised
  maxRunHours     Float    @default(12)      // "ON beyond a configured duration"
  active          Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events        GeneratorEvent[]
  readings      GeneratorReading[]
  refills       GeneratorRefill[]
  discrepancies GeneratorDiscrepancy[]

  @@unique([centerId, code])
  @@index([centerId, active])
}

// An ON or OFF event. `atServer` is the authoritative time — never client-supplied.
// `atClaimed` records what the operator said, so backdating is detectable rather
// than silently accepted.
model GeneratorEvent {
  id          String       @id @default(cuid())
  generatorId String
  generator   Generator    @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  centerId    String
  type        GenEventType
  atServer    DateTime     @default(now())
  atClaimed   DateTime?
  userId      String
  user        User         @relation("GenEventUser", fields: [userId], references: [id])

  reason      String?
  loadReading Float?
  comments    String?      @db.Text

  // Set on the OFF event once the run is closed out.
  runMinutes  Float?
  fuelUsedL   Float?
  litresPerHour Float?

  readings    GeneratorReading[]

  @@index([generatorId, atServer])
  @@index([centerId, type])
}

// Append-only ledger. Every row links to the previous reading for the same
// generator, so deltas are computable without re-scanning the table.
model GeneratorReading {
  id                String          @id @default(cuid())
  generatorId       String
  generator         Generator       @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  centerId          String
  at                DateTime        @default(now())   // server time
  userId            String
  user              User            @relation("GenReadingUser", fields: [userId], references: [id])

  kind              GenReadingKind  @default(SPOT_CHECK)
  runningAtReading  Boolean         @default(false)   // was the generator ON when taken

  // Authoritative values (what the operator confirmed after seeing the OCR guess).
  fuelReading       Float?
  hourMeter         Float?

  // What OCR read, kept alongside so the two can be compared.
  ocrFuel           Float?
  ocrHourMeter      Float?
  ocrConfidence     Float?
  ocrRaw            String?         @db.Text

  photoId           String?
  photo             GeneratorPhoto? @relation(fields: [photoId], references: [id])

  previousReadingId String?         @unique
  previousReading   GeneratorReading?  @relation("ReadingChain", fields: [previousReadingId], references: [id])
  nextReading       GeneratorReading?  @relation("ReadingChain")

  fuelDelta         Float?
  hourDelta         Float?

  eventId           String?
  event             GeneratorEvent? @relation(fields: [eventId], references: [id])

  createdAt         DateTime        @default(now())

  discrepancies     GeneratorDiscrepancy[]

  @@index([generatorId, at])
  @@index([centerId, at])
}

// Generator photos live in the same private store as inspection photos and are
// served through the same signed-URL route.
model GeneratorPhoto {
  id          String   @id @default(cuid())
  generatorId String
  centerId    String
  userId      String
  kind        String   // PANEL | TANK | METER | REFILL
  filePath    String   @db.Text
  mimeType    String
  sizeBytes   Int
  sha256      String
  pHash       String?
  captureAt   DateTime?
  serverAt    DateTime @default(now())
  lat         Float?
  lng         Float?
  flags       String?  @db.Text
  createdAt   DateTime @default(now())

  readings    GeneratorReading[]
  refills     GeneratorRefill[]

  @@index([generatorId, createdAt])
  @@index([sha256])
  @@index([pHash])
}

model GeneratorRefill {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  centerId    String
  at          DateTime  @default(now())
  userId      String
  user        User      @relation("GenRefillUser", fields: [userId], references: [id])
  litres      Float
  costPerL    Float?
  totalCost   Float?
  vendor      String?
  invoiceRef  String?
  photoId     String?
  photo       GeneratorPhoto? @relation(fields: [photoId], references: [id])
  fuelBefore  Float?
  fuelAfter   Float?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([generatorId, at])
  @@index([centerId, at])
}

// One row per rule trip. `ruleCode` maps to lib/housekeeping/generator-rules.ts.
model GeneratorDiscrepancy {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  centerId    String
  ruleCode    String    // GEN_FUEL_NO_EVENT, GEN_HOURS_NO_EVENT, …
  severity    String    @default("HIGH") // CRITICAL | HIGH | MEDIUM | LOW
  title       String
  detail      String?   @db.Text
  expected    String?
  actual      String?
  delta       Float?
  readingId   String?
  reading     GeneratorReading? @relation(fields: [readingId], references: [id])
  eventId     String?
  detectedAt  DateTime  @default(now())

  // Triage — the record itself is never deleted.
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("GenDiscrepancyResolver", fields: [resolvedById], references: [id])
  resolution   String?   @db.Text
  issueId      String?   // optional bridge into the Phase 6 issue workflow

  @@index([generatorId, detectedAt])
  @@index([centerId, resolvedAt])
  @@index([ruleCode])
}

// ============================================================================
// HOUSEKEEPING — ALERTS, NOTIFICATIONS & SCORING (Phase 8)
// docs/housekeeping-module.md §3c · brief §12
// ============================================================================

enum HkAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

// A named recipient list. `kind` maps to the brief's groups (management,
// facility, accounts, security) and a group may be scoped to one centre.
model EmailGroup {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("CUSTOM") // MANAGEMENT|FACILITY|ACCOUNTS|SECURITY|CENTRE|CUSTOM
  centerId  String?                     // null = applies to every centre
  center    Center?  @relation(fields: [centerId], references: [id])
  toEmails  String   @db.Text           // JSON array
  ccEmails  String?  @db.Text           // JSON array
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, active])
  @@index([centerId])
}

// One row per alert-worthy event. Deliberately separate from HkIssue: an issue
// is work to be done, an alert is a notification about something that happened.
model HkAlert {
  id          String        @id @default(cuid())
  centerId    String
  center      Center        @relation(fields: [centerId], references: [id])
  alertType   String        // GENERATOR_DISCREPANCY | CRITICAL_ISSUE | ISSUE_OVERDUE | MISSED_INSPECTION | SUSPICIOUS_SCAN | DUPLICATE_PHOTO
  severity    String        @default("HIGH") // CRITICAL|HIGH|MEDIUM|LOW
  title       String
  body        String?       @db.Text
  // Loose links — an alert may point at any subject without a hard FK per type.
  subjectType String?       // HkIssue | GeneratorDiscrepancy | InspectionVisit
  subjectId   String?
  dedupeKey   String?       // stops the same condition alerting repeatedly
  meta        String?       @db.Text     // JSON: readings, deltas, photo ids, deep link

  status      HkAlertStatus @default(NEW)
  ackById     String?
  ackBy       User?         @relation("HkAlertAck", fields: [ackById], references: [id])
  ackAt       DateTime?
  resolvedAt  DateTime?

  createdAt   DateTime      @default(now())

  notifications NotificationLog[]

  @@index([centerId, status])
  @@index([alertType, createdAt])
  @@unique([dedupeKey])
}

// Delivery record — who was emailed, whether it left the building, and what
// happened next. Kept append-only.
model NotificationLog {
  id         String    @id @default(cuid())
  alertId    String?
  alert      HkAlert?  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel    String    @default("EMAIL") // EMAIL | IN_APP
  recipients String    @db.Text          // JSON array of addresses
  subject    String?
  status     String    @default("PENDING") // PENDING|SENT|FAILED|SKIPPED
  error      String?   @db.Text
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([alertId])
  @@index([status, createdAt])
}

// Computed efficiency score for a person over a period. Recomputable at any
// time; a manual override is stored alongside the computed value, never
// replacing it, so the audit trail survives.
model HkEfficiencyScore {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("HkEfficiencyUser", fields: [userId], references: [id])
  centerId     String?
  periodStart  DateTime
  periodEnd    DateTime
  score        Float                     // 0–100 computed
  breakdown    String   @db.Text         // JSON: per-factor scores + weights + reasons
  issuesClosed Int      @default(0)
  issuesLate   Int      @default(0)
  reworkCount  Int      @default(0)

  overrideScore  Float?
  overrideReason String? @db.Text
  overrideById   String?
  overrideBy     User?    @relation("HkEfficiencyOverride", fields: [overrideById], references: [id])
  overrideAt     DateTime?

  createdAt    DateTime @default(now())

  @@unique([userId, periodStart, periodEnd])
  @@index([centerId, periodStart])
}

// ============================================================================
// HOUSEKEEPING — CLIENT CLEANING REQUESTS (Phase 9)
// docs/housekeeping-module.md §3d · brief §§23–35
// ============================================================================

enum CrStatus {
  NEW
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  AWAITING_CONFIRMATION
  CLOSED
  REOPENED
  CANCELLED
}

enum CrPriority {
  NORMAL
  URGENT
}

// What a client can ask for. Seeded with the brief's 16 services + 8
// consumables, then fully admin-editable — quantities are data, not code.
model CleaningRequestType {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  group        String   @default("CLEANING") // CLEANING | CONSUMABLE | REPORT
  slaMinutes   Int      @default(20)         // per-type target, brief §32
  autoUrgent   Boolean  @default(false)      // e.g. spill, broken glass
  requiresPhotos Int    @default(1)          // after-photos needed to complete
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests     CleaningRequest[]

  @@index([group, active])
}

// A client-facing QR, deliberately SEPARATE from LocationQrCode so a staff
// sticker and a client sticker can never be confused for one another.
model ClientQrCode {
  id         String             @id @default(cuid())
  locationId String
  location   InspectionLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code       String             @unique
  version    Int                @default(1)
  active     Boolean            @default(true)
  rotatedAt  DateTime?
  createdAt  DateTime           @default(now())

  @@index([locationId, active])
}

model CleaningRequest {
  id            String              @id @default(cuid())
  ticketNo      String              @unique      // human-readable, e.g. CR-2608-0042
  centerId      String
  center        Center              @relation(fields: [centerId], references: [id])
  locationId    String?
  location      InspectionLocation? @relation(fields: [locationId], references: [id])
  floorId       String?

  typeId        String?
  type          CleaningRequestType? @relation(fields: [typeId], references: [id])
  typeNameSnapshot String                          // survives a type being renamed later

  // Requester — no account required, so these are plain fields.
  clientId      String?
  client        Client?             @relation(fields: [clientId], references: [id])
  clientName    String?
  clientPhone   String?
  clientEmail   String?

  description   String?             @db.Text
  photoId       String?                            // optional client photo
  priority      CrPriority          @default(NORMAL)
  autoUrgentReason String?
  status        CrStatus            @default(NEW)

  assigneeId    String?
  assignee      User?               @relation("CrAssignee", fields: [assigneeId], references: [id])

  dueAt         DateTime?
  acceptedAt    DateTime?
  onTheWayAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  closedAt      DateTime?

  // Completion evidence. `qrVerified` records whether the staff member re-scanned
  // the area QR — brief §28 requires it, and a completion without it is flagged.
  qrVerified    Boolean             @default(false)
  qrVerifiedAt  DateTime?

  // Client confirmation (brief §31).
  confirmation  String?                            // SATISFACTORY | PARTIAL | NOT_COMPLETED
  rating        Int?                               // 1–5
  clientComment String?             @db.Text
  confirmedAt   DateTime?

  // Complaint conversion (brief §33).
  isComplaint   Boolean             @default(false)
  complaintReason String?
  convertedAt   DateTime?

  // Public status link — unguessable, no login.
  statusToken   String              @unique
  reopenCount   Int                 @default(0)
  slaBreached   Boolean             @default(false)

  sourceIp      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  events        CleaningRequestEvent[]
  photos        CleaningRequestPhoto[]

  @@index([centerId, status])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([clientId, createdAt])
  @@index([locationId, createdAt])
}

// Append-only lifecycle trail: every status change, who made it and when.
model CleaningRequestEvent {
  id        String          @id @default(cuid())
  requestId String
  request   CleaningRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String?
  actor      User?           @relation("CrEventActor", fields: [actorId], references: [id])
  byClient   Boolean         @default(false)
  note       String?         @db.Text
  createdAt  DateTime        @default(now())

  @@index([requestId, createdAt])
}

// Before (client-supplied) and after (staff) photographs.
model CleaningRequestPhoto {
  id        String          @id @default(cuid())
  requestId String
  request   CleaningRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      String          @default("AFTER") // BEFORE | AFTER
  filePath  String          @db.Text
  mimeType  String
  sizeBytes Int
  sha256    String
  pHash     String?
  userId    String?
  flags     String?         @db.Text
  createdAt DateTime        @default(now())

  @@index([requestId, kind])
  @@index([sha256])
}

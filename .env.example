DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
APP_URL="http://localhost:3000"

# SMTP for sending emails (recurring invoices, rent revision reminders, proposals)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="erp@your-coworking.com"

# DigiLocker (KYC) — placeholder; integrate via partner API
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# WhatsApp Business API (for capturing client comments)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Housekeeping / inspection module
# Where inspection photos are written. MUST stay outside public/ — these are
# evidence files and are served only through signed, role-checked URLs.
HK_UPLOAD_DIR=""
# Secret for signing photo URLs. Falls back to JWT_SECRET when unset.
HK_SIGNED_URL_SECRET=""
# Reserved for a future MinIO/S3 driver; only "local" is implemented today.
HK_STORAGE_DRIVER="local"
# Housekeeping — corrective-action escalation (Phase 6)
# Shared secret so crontab can POST /api/housekeeping/cron/escalations without a session.
HK_CRON_SECRET=""
# Comma-separated escalation recipients; falls back to active ADMIN/OWNER emails when empty.
HK_ESCALATION_EMAILS=""
# Housekeeping — generator panel/meter OCR (Phase 7)
# "stub" (default) returns no reading, so the operator's typed value is authoritative.
# Set to a real engine to satisfy acceptance criterion #15 — see docs/housekeeping-deferred.md D-17.
HK_OCR_DRIVER="stub"

# Housekeeping — public client cleaning requests (Phase 9)
# Optional shared secret for the public submit endpoint. Same-origin browser posts
# from /qr/a/[code] always pass; server-to-server callers must send x-hk-secret.
# Leave empty to accept any origin (still rate-limited).
HK_PUBLIC_SECRET=""

# Housekeeping — AI vision analysis (Phase 5)
# "stub" (default) stores and queues photographs but performs no analysis; its
# findings carry 0.05 confidence so they can never auto-create issues.
# "ollama" keeps photographs on your own infrastructure (recommended).
# "openai-compatible" sends photographs to an external endpoint.
HK_AI_DRIVER="stub"
HK_AI_BASE_URL=""        # ollama: http://localhost:11434 · openai: https://api.openai.com/v1
HK_AI_MODEL=""           # e.g. llava:7b, llama3.2-vision:11b, gpt-4o-mini
HK_AI_API_KEY=""         # openai-compatible only
HK_AI_TIMEOUT_MS="120000"
HK_AI_MODEL_VERSION=""   # optional label recorded on every finding
